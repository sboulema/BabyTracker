{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "System.Net.Http.HttpClient.IAuthenticationConnection": "Warning",
      "System.Net.Http.HttpClient.IManagementConnection": "Warning"
    },
    "Console": {
      "FormatterOptions": {
        "TimestampFormat": "HH:mm:ss"
      }
    }
  },
  "AllowedHosts": "*",
  "BabyTrackerSync": {
    "Enabled": false,
    "BaseUrl": "https://prodapp.babytrackers.com"
  }
}
