@model BabyTracker.Models.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "BabyTracker";
}

<h1 class="display-4 text-center my-5">Login</h1>

@await Html.PartialAsync("_Notification")

<div class="row justify-content-center">
  <div class="col-12 col-md-8 col-lg-5 col-xl-4">
    <div class="card shadow-sm">
      <div class="card-body p-4">
        <form asp-action="Login" asp-controller="Account" asp-route-returnurl="@ViewBag.ReturnUrl">
          <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

          <div class="form-floating mb-3">
            <input asp-for="EmailAddress" type="email" class="form-control" placeholder="Email" autocomplete="email" autofocus />
            <label asp-for="EmailAddress">Email</label>
          </div>

          <div class="form-floating mb-3">
            <input asp-for="Password" type="password" class="form-control" placeholder="Password" autocomplete="current-password" />
            <label asp-for="Password">Password</label>
          </div>

          <div class="d-flex justify-content-between align-items-center mb-4">
            <div class="form-check">
              <input asp-for="RememberMe" class="form-check-input" />
              <label asp-for="RememberMe" class="form-check-label">Remember me</label>
            </div>
            <a href="/account/resetpassword" class="small">Forgot password?</a>
          </div>

          <div class="d-grid">
            <button type="submit" class="btn btn-primary btn-lg">Login</button>
          </div>
        </form>
      </div>

      <div class="card-footer text-center py-3">
        New here? <a href="/account/register">Create an account</a>
      </div>
    </div>
  </div>
</div>