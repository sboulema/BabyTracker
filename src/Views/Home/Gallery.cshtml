@using System.Text.Json

@model BabyTracker.Models.ViewModels.GalleryViewModel

@{
    ViewData["Title"] = "Gallery - BabyTracker";

    var pictures = Model?.Pictures.ToList() ?? [];

    var previewPictures = pictures
        .Take(3)
        .Select((picture, index) => (picture, index))
        .ToList();

    var dynamicEl = pictures.Select(p => new
    {
        src = $"/picture/{p.FileName}",
        thumb = $"/picture/{p.FileName}/thumbnail"
    });
}

@if (pictures.Count > 0)
{
    <div id="gallery" class="row">
        @foreach (var (picture, index) in previewPictures)
        {
            <div class="col-lg-6 col-md-6 col-xs-6 mb-3" role="button">
                <img src="~/picture/@picture.FileName/thumbnail" class="img-thumbnail gallery-item" data-index="@index" />
            </div>
        }

        @if (pictures.Count > 3)
        {
            <div id="viewAllBtn" class="col-lg-6 col-md-6 col-xs-6 mb-3" role="button">
                <div class="card">
                    <img src="~/picture/@pictures[3].FileName/thumbnail" class="card-img img-thumbnail" />
                    <div class="card-img-overlay align-content-center">
                        <h1 class="card-title text-center text-light" style="text-shadow: 2px 2px black;">View all (@pictures.Count)</h1>
                    </div>
                </div>
            </div>
        }
    </div>
}

@section Stylesheets
{
    <link type="text/css" rel="stylesheet" href="/css/lightgallery.css" />
}

@section Scripts
{
    @if (pictures.Count > 0)
    {
        <script src="/js/lightgallery.umd.js"></script>

        <script>
            const gallery = lightGallery(document.getElementById('gallery'), {
                dynamic: true,
                dynamicEl: @Html.Raw(JsonSerializer.Serialize(dynamicEl)),
            });

            document.querySelectorAll('.gallery-item').forEach(item => {
                item.addEventListener('click', () => {
                    gallery.openGallery(parseInt(item.dataset.index));
                });
            });

            document.getElementById('viewAllBtn')?.addEventListener('click', () => {
                gallery.openGallery(3);
            });
        </script>
    }
}