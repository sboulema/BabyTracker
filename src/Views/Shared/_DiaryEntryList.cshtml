@model BabyTracker.Models.ViewModels.DiaryEntryViewModel
@{
    var babyName = ViewContext.RouteData.Values["babyName"]?.ToString();
}

<div class="card mb-3 border-0 border-top @Model.CssClass">
    <div class="row g-0">
        <div class="col" style="flex: 0 0 64px">
            <img src="@Model.IconURL" class="img-fluid rounded-start" width="64" />
        </div>
        <div class="col">
            <div class="card-body pb-0">
                <h5 class="card-title bt-@Model.CssColor-title">@Model.Title</h5>
                @if (!string.IsNullOrEmpty(Model.Note))
                {
                    <p class="card-text bt-@Model.CssColor-background bt-entry-note">@Model.Note</p>
                }
                @if (!string.IsNullOrEmpty(Model.PictureFileName))
                {
                    <a href="~/picture/@Model.PictureFileName" target="_blank"><img src="~/picture/@Model.PictureFileName/thumbnail" class="img-thumbnail" width="200" /></a>
                }
            </div>
            <div class="card-footer text-body-secondary bg-transparent border-0 text-end py-0">
                @if (!string.IsNullOrEmpty(Model.EditUrl))
                {
                    <a href="@Model.EditUrl" class="btn btn-sm btn-outline-secondary me-2" title="Edit">
                        <i class="fas fa-pen"></i> Edit
                    </a>
                }
                @Model.Date @Model.Time
                @if (ViewBag.CanDelete == true && Model.Type is not null && Model.Id != Guid.Empty)
                {
                    <form method="post" class="d-inline" asp-controller="Home" asp-action="DeleteEntry" asp-route-babyName="@babyName"
                          asp-route-type="@Model.Type" asp-route-id="@Model.Id" asp-route-date="@Model.DateIso"
                          onsubmit="return confirm('Delete this entry? This cannot be undone.');">
                        <button type="submit" class="btn btn-link btn-sm text-danger p-0 ms-2" title="Delete entry">
                            <i class="fas fa-trash"></i>
                        </button>
                    </form>
                }
            </div>
        </div>
    </div>
</div>